<view class="page {{elder ? 'elder' : ''}}">
  <view class="card" wx:if="{{needBaby}}">
    <view class="h1">先建立宝宝档案</view>
    <button class="btn btn-primary btn-block" bindtap="goBaby">去填写</button>
  </view>
  <block wx:else>
    <view class="muted">剂量和次数按医嘱自己填。这里只负责记和提醒，不算该吃多少。</view>
    <view class="card" wx:if="{{!templateReady}}">
      <view class="h2">微信通知还没打开</view>
      <view class="muted">每一顿仍然会出现在今天。配置订阅模板后，手机会收到服务通知。</view>
    </view>
    <button wx:if="{{templateReady}}" class="btn btn-ghost btn-block" bindtap="allowRemind">允许吃药提醒</button>
    <view class="card" wx:for="{{doses}}" wx:key="_id">
      <view class="row">
        <view class="med-time">{{item.slotTime}}</view>
        <view class="muted">{{item.statusText}}</view>
      </view>
      <view class="h2">{{item.name}}</view>
      <view class="muted">计划 {{item.planDoseText}}<text wx:if="{{item.memberName}}"> · {{item.memberName}}</text></view>
      <view class="muted" wx:if="{{item.note}}">{{item.note}}</view>
      <view wx:if="{{editId === item._id}}">
        <stepper elder="{{elder}}" value="{{editAmount}}" min="{{0}}" max="{{100}}" step="{{0.5}}" unit="{{item.doseUnit}}" bind:change="onEditAmount" />
        <button class="btn btn-primary btn-block" data-id="{{item._id}}" bindtap="confirmAmount">按这个数量记已吃</button>
      </view>
      <block wx:else>
        <button class="btn btn-primary btn-block" data-id="{{item._id}}" data-when="now" bindtap="markTaken">吃了</button>
        <button class="btn btn-ghost btn-block" data-id="{{item._id}}" data-when="plan" bindtap="markTaken">按计划时间补记</button>
        <button class="btn btn-line btn-block" data-id="{{item._id}}" bindtap="markSkip">没吃</button>
        <view class="link" data-id="{{item._id}}" data-amount="{{item.doseAmount}}" bindtap="startEdit">数量不对</view>
      </block>
    </view>
    <view class="muted" wx:if="{{!doses.length}}">今天还没有按顿安排的药。</view>
    <view class="h2" style="margin: 28rpx 0 12rpx;">进行中的疗程</view>
    <view class="card" wx:for="{{meds}}" wx:key="_id">
      <view class="h2">{{item.name}}</view>
      <view class="muted">{{item.planText}}</view>
      <view class="muted">{{item.startDay}} 到 {{item.endDay}}<text wx:if="{{item.mealNote}}"> · {{item.mealNote}}</text></view>
      <button wx:if="{{item.frequencyType === 'asNeeded'}}" class="btn btn-primary btn-block" data-id="{{item._id}}" bindtap="takeNow">现在吃了</button>
      <button class="btn btn-ghost btn-block" data-id="{{item._id}}" bindtap="edit">修改</button>
      <button class="btn btn-line btn-block" data-id="{{item._id}}" bindtap="stop">结束用药</button>
    </view>
    <button class="btn btn-primary btn-block" bindtap="create">添加用药</button>
  </block>
</view>
