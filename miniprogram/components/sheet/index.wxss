.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  background: rgba(38, 34, 51, 0.42);
  animation: sheet-fade 0.2s ease-out both;
}
.sheet-panel {
  width: 100%;
  box-sizing: border-box;
  padding: var(--sp-2, 16rpx) var(--sp-4, 32rpx) calc(var(--sp-2, 16rpx) + env(safe-area-inset-bottom));
  background: var(--surface, #FFFFFF);
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(58, 44, 120, 0.18);
  animation: sheet-up 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes sheet-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto var(--sp-2, 16rpx);
  border-radius: 999rpx;
  background: var(--surface-3, #E7E0F7);
}
.sheet-title {
  padding: var(--sp-1, 8rpx) 0 var(--sp-2, 16rpx);
  font-size: var(--fs-heading, 32rpx);
  font-weight: 700;
  color: var(--ink, #262233);
}
.sheet-item {
  display: flex;
  align-items: center;
  min-height: var(--tap-min, 88rpx);
  padding: var(--sp-2, 16rpx) 0;
  border-top: 1rpx solid var(--line, #E6E0F0);
  animation: fade-up 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes fade-up {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.sheet-item.is-pressed {
  background: var(--surface-2, #F1EDFA);
}
.sheet-main {
  flex: 1;
  min-width: 0;
}
.sheet-label {
  font-size: var(--fs-body, 30rpx);
  font-weight: 600;
  color: var(--ink, #262233);
}
.sheet-item.danger .sheet-label {
  color: var(--danger, #B23A55);
}
.sheet-hint {
  margin-top: 4rpx;
  font-size: var(--fs-caption, 24rpx);
  color: var(--ink-3, #6F6781);
}
.sheet-chev {
  color: var(--ink-3, #6F6781);
  font-size: 40rpx;
  line-height: 1;
  margin-left: var(--sp-2, 16rpx);
}
.sheet-cancel {
  margin-top: var(--sp-3, 24rpx);
}
.sheet-cancel::after {
  border: 0;
}
.sheet-panel.elder .sheet-label {
  font-size: 36rpx;
}
.sheet-panel.elder .sheet-hint {
  font-size: 30rpx;
}
