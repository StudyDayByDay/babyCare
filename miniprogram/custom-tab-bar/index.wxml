<view class="bar {{elder ? 'elder' : ''}}">
  <view
    class="item {{selected === index ? 'on' : ''}}"
    wx:for="{{list}}"
    wx:key="text"
    data-index="{{index}}"
    bindtap="onSwitch"
    hover-class="item-pressed"
  >
    <view class="tab-icon">
      <icon name="{{selected === index ? item.iconOn : item.icon}}" size="{{44}}" elder="{{elder}}" />
    </view>
    <text class="item-text">{{item.text}}</text>
  </view>
</view>
