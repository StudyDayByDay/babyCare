<view class="page tab {{elder ? 'elder' : ''}} {{night ? 'night' : ''}}">
  <block wx:if="{{loading}}">
    <view class="skeleton-card">
      <view class="skeleton-line w-40"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line w-70"></view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-line w-70"></view>
      <view class="skeleton-line"></view>
    </view>
  </block>

  <view wx:elif="{{pageError}}" class="card error-state">
    <view class="heading">还没连上云</view>
    <view class="caption mt-1">{{pageError}}</view>
    <button class="btn btn-primary btn-block" hover-class="is-pressed" bindtap="retry">再试一次</button>
  </view>

  <view wx:elif="{{needBaby}}" class="card">
    <empty
      icon="baby"
      tone="med"
      title="先记下宝宝的出生日"
      hint="用来算第几天，也用来决定这个阶段要记哪些。"
      action-text="建立档案"
      elder="{{elder}}"
      bind:action="goBaby"
    />
  </view>

  <block wx:elif="{{baby}}">
    <view class="hero delay-1">
      <view class="hero-orb orb-a"></view>
      <view class="hero-orb orb-b"></view>

      <view class="hero-top">
        <view class="hero-copy">
          <view class="hero-kicker">{{pretty}}</view>
          <view class="hero-name">{{baby.nickname}}</view>
          <view class="hero-meta">{{heroMeta}}</view>
        </view>
        <view class="hero-avatar">{{nicknameInitial}}</view>
      </view>

      <view class="hero-day">
        <view class="hero-day-main">
          <text class="hero-day-prefix">第</text>
          <text class="hero-day-num num">{{nums.day}}</text>
          <text class="hero-day-unit">天</text>
        </view>
        <text class="hero-day-label">来到家里</text>
      </view>

      <view class="hero-stats">
        <view class="hero-stat">
          <view class="hero-stat-value num">{{nums.feed}}</view>
          <view class="hero-stat-label">喂奶</view>
        </view>
        <view class="hero-stat-sep"></view>
        <view class="hero-stat">
          <view class="hero-stat-value num">{{nums.diaper}}</view>
          <view class="hero-stat-label">尿布</view>
        </view>
        <view class="hero-stat-sep"></view>
        <view class="hero-stat">
          <view class="hero-stat-value num">{{animSleepText}}</view>
          <view class="hero-stat-label">睡眠</view>
        </view>
      </view>
    </view>

    <view wx:if="{{nextGroup}}" class="card card-accent delay-2">
      <view class="row">
        <view class="heading med-title"><view class="pulse-dot"></view>今天的药</view>
        <view class="pill gold">已吃 {{summary.medTaken}} / {{summary.medTotal}}</view>
      </view>
      <view class="med-time mt-2">{{nextGroup.time}}</view>
      <view class="dose-line" wx:for="{{nextGroup.items}}" wx:key="_id">{{item.name}} {{item.planDoseText}}</view>
      <view class="progress mt-2">
        <view class="progress-fill brand" style="width: {{medPercent}}%;"></view>
      </view>
      <button
        class="btn btn-primary btn-block mt-3"
        hover-class="is-pressed"
        loading="{{taking}}"
        disabled="{{taking}}"
        bindtap="takeNext"
      >这顿吃了</button>
    </view>

    <view wx:if="{{since.length}}" class="card since-card delay-3">
      <view class="since-row">
        <view
          class="since-item"
          wx:for="{{since}}"
          wx:key="label"
          style="animation-delay: {{index * 60 + 160}}ms"
        >
          <view class="bubble sm tone-{{item.tone}}">
            <icon name="{{item.icon}}" size="{{36}}" elder="{{elder}}" />
          </view>
          <view class="since-value num">{{item.text}}</view>
          <view class="since-label">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="quick-grid mb-3">
      <view
        class="quick-card"
        wx:for="{{quick}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onAction"
        hover-class="is-pressed"
        style="animation-delay: {{index * 55 + 180}}ms"
      >
        <text class="quick-arrow">›</text>
        <view class="bubble tone-{{item.tone}}">
          <icon name="{{item.icon}}" size="{{44}}" elder="{{elder}}" />
        </view>
        <view class="quick-title">{{item.title}}</view>
        <view class="quick-hint" wx:if="{{item.hint}}">{{item.hint}}</view>
      </view>
    </view>

    <view class="card delay-4">
      <view class="section-head">
        <view class="section-title">今日明细</view>
        <view class="link" bindtap="goStats" hover-class="is-pressed">统计</view>
      </view>
      <view class="stat-grid">
        <view class="stat-tile" style="animation-delay: 280ms">
          <view class="stat-value num">{{nums.milk}}{{nums.milkUnit}}</view>
          <view class="stat-label">奶量</view>
        </view>
        <view class="stat-tile" style="animation-delay: 320ms">
          <view class="stat-value num">{{nums.breastMin}}分钟</view>
          <view class="stat-label">亲喂</view>
        </view>
        <view class="stat-tile" style="animation-delay: 360ms">
          <view class="stat-value num">{{nums.poop}}次</view>
          <view class="stat-label">大便</view>
        </view>
        <view class="stat-tile" style="animation-delay: 400ms">
          <view class="stat-value num">{{nums.medTaken}}/{{summary.medTotal}}</view>
          <view class="stat-label">用药</view>
        </view>
      </view>
    </view>

    <view class="card delay-5">
      <view class="section-head">
        <view class="section-title">今天的记录</view>
        <view class="link" bindtap="goRecord" hover-class="is-pressed">查看全部</view>
      </view>
      <view class="caption" wx:if="{{dailyText}}">护理：{{dailyText}}</view>
      <empty
        wx:if="{{!shownRecords.length}}"
        compact
        icon="note"
        tone="note"
        title="今天还没记"
        hint="点上面的喂奶开始，三秒就能记一笔。"
        elder="{{elder}}"
      />
      <view
        class="timeline-row"
        wx:for="{{shownRecords}}"
        wx:key="_id"
        data-id="{{item._id}}"
        data-type="{{item.type}}"
        bindtap="openRecord"
        hover-class="is-pressed"
        style="animation-delay: {{index * 45 + 320}}ms"
      >
        <view class="timeline-clock">{{item.timeText}}</view>
        <view class="bubble sm tone-{{item.tone}}">
          <icon name="{{item.icon}}" size="{{40}}" elder="{{elder}}" />
        </view>
        <view class="timeline-body">
          <view class="timeline-title">{{item.text}}</view>
          <view class="timeline-meta" wx:if="{{item.memberName}}">{{item.memberName}}</view>
        </view>
        <text class="timeline-chev">›</text>
      </view>
    </view>
  </block>
</view>
