<view class="page tab {{elder ? 'elder' : ''}} {{night ? 'night' : ''}} {{settled ? 'settled' : ''}}">
  <block wx:if="{{loading}}">
    <view class="skeleton-card">
      <view class="skeleton-line w-40"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line w-70"></view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-line w-70"></view>
      <view class="skeleton-line"></view>
    </view>
  </block>

  <view wx:elif="{{pageError}}" class="card error-state">
    <view class="heading">还没连上云</view>
    <view class="caption mt-1">{{pageError}}</view>
    <button class="btn btn-primary btn-block" hover-class="is-pressed" bindtap="retry">再试一次</button>
  </view>

  <view wx:elif="{{needBaby}}" class="card">
    <empty
      icon="baby"
      tone="med"
      title="先记下宝宝的出生日"
      hint="用来算第几天，也用来决定这个阶段要记哪些。"
      action-text="建立档案"
      elder="{{elder}}"
      bind:action="goBaby"
    />
  </view>

  <block wx:elif="{{baby}}">
    <view class="card today-board">
      <view class="board-top">
        <view class="eyebrow board-date">{{pretty}}</view>
        <view class="board-avatar">{{nicknameInitial}}</view>
      </view>
      <view class="board-name">{{baby.nickname}}</view>
      <view class="board-meta">
        <text class="board-day">第 {{nums.day}} 天</text>
        <text class="board-stage">{{heroMeta}}</text>
      </view>
      <view class="board-divider"></view>

      <view class="summary-grid">
        <view class="summary-item">
          <view class="eyebrow">喂奶</view>
          <view class="summary-line">
            <text class="summary-value num">{{nums.feed}}</text>
            <text class="summary-unit">次</text>
          </view>
        </view>
        <view class="summary-item">
          <view class="eyebrow">奶量</view>
          <view class="summary-line">
            <text class="summary-value num">{{nums.milk}}</text>
            <text class="summary-unit">毫升</text>
          </view>
        </view>
        <view class="summary-item">
          <view class="eyebrow">尿布</view>
          <view class="summary-line">
            <text class="summary-value num">{{nums.diaper}}</text>
            <text class="summary-unit">次</text>
          </view>
        </view>
        <view class="summary-item">
          <view class="eyebrow">睡眠</view>
          <view class="summary-line">
            <text class="summary-value num">{{sleepHours}}</text>
            <text class="summary-unit">小时</text>
          </view>
        </view>
      </view>
      <view class="summary-foot" wx:if="{{since.length}}">
        <view class="since-inline" wx:for="{{since}}" wx:key="label">
          <view class="since-dot {{item.tone}}"></view>
          <text>{{item.label}} {{item.text}}</text>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{chart.length}}">
      <view class="card-head">
        <view class="card-title">本周节奏</view>
        <view class="link sm" bindtap="goStats" hover-class="is-pressed">统计 ›</view>
      </view>
      <view class="segmented sm mt-2">
        <view
          class="segmented-item {{chartMetric === 'feed' ? 'on' : ''}}"
          data-metric="feed"
          bindtap="onChartMetric"
          hover-class="is-pressed"
        >喂奶</view>
        <view
          class="segmented-item {{chartMetric === 'diaper' ? 'on' : ''}}"
          data-metric="diaper"
          bindtap="onChartMetric"
          hover-class="is-pressed"
        >尿布</view>
        <view
          class="segmented-item {{chartMetric === 'sleep' ? 'on' : ''}}"
          data-metric="sleep"
          bindtap="onChartMetric"
          hover-class="is-pressed"
        >睡眠</view>
      </view>
      <view class="chart">
        <view class="chart-row">
          <view
            class="chart-col"
            wx:for="{{chart}}"
            wx:key="day"
            data-day="{{item.day}}"
            bindtap="onChartDay"
          >
            <view class="chart-value">{{item.value}}</view>
            <view class="chart-track">
              <view class="chart-bar {{item.percent ? '' : 'zero'}} {{item.isToday ? 'today' : ''}}" style="height: {{item.percent}}%;"></view>
            </view>
            <view class="chart-label {{item.isToday ? 'today' : ''}}">{{item.label}}</view>
          </view>
        </view>
      </view>
      <view class="chart-foot">
        <text class="chart-avg">日均 {{chartAvg}}</text>
        <text class="chart-avg">近 7 天</text>
      </view>
    </view>

    <view wx:if="{{nextGroup}}" class="card card-accent">
      <view class="card-head">
        <view class="med-title">
          <view class="pulse-dot"></view>
          <text class="card-title">接下来用药</text>
        </view>
      </view>
      <view class="row mt-2">
        <view class="med-time">{{nextGroup.time}}</view>
        <view class="pill accent">待吃</view>
      </view>
      <view class="progress mt-2">
        <view class="progress-fill accent" style="width: {{medPercent}}%;"></view>
      </view>
      <view class="dose-line" wx:for="{{nextGroup.items}}" wx:key="_id">
        <text class="dose-name">{{item.name}}</text>
        <text class="dose-amount">{{item.planDoseText}}</text>
      </view>
      <view class="med-action">
        <button
          class="btn btn-primary btn-block"
          hover-class="is-pressed"
          loading="{{taking}}"
          disabled="{{taking}}"
          bindtap="takeNext"
        >这顿吃了</button>
      </view>
    </view>

    <view class="card">
      <view class="card-head">
        <view class="card-title">记一笔</view>
        <view class="link sm" bindtap="goRecord" hover-class="is-pressed">全部 ›</view>
      </view>
      <view class="tool-grid">
        <view
          class="tool-tile"
          wx:for="{{quick}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onAction"
          hover-class="is-pressed"
        >
          <view class="tool-icon tone-{{item.tone}}">
            <icon name="{{item.icon}}" size="{{32}}" elder="{{elder}}" />
          </view>
          <view class="tool-label">{{item.title}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-head">
        <view class="card-title">今日明细</view>
        <view class="link sm" bindtap="goStats" hover-class="is-pressed">统计 ›</view>
      </view>
      <view class="kv-grid">
        <view class="kv-item">
          <text class="kv-label">总奶量</text>
          <text class="kv-value">{{nums.milk}} 毫升</text>
        </view>
        <view class="kv-item">
          <text class="kv-label">瓶喂母乳</text>
          <text class="kv-value">{{nums.breastMl}} 毫升</text>
        </view>
        <view class="kv-item">
          <text class="kv-label">配方奶</text>
          <text class="kv-value">{{nums.formulaMl}} 毫升</text>
        </view>
        <view class="kv-item">
          <text class="kv-label">亲喂</text>
          <text class="kv-value">{{nums.breastMin}} 分钟</text>
        </view>
        <view class="kv-item">
          <text class="kv-label">大便</text>
          <text class="kv-value">{{nums.poop}} 次</text>
        </view>
        <view class="kv-item">
          <text class="kv-label">用药</text>
          <text class="kv-value">{{nums.medTaken}}/{{summary.medTotal}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-head">
        <view class="card-title">最近记录</view>
        <view class="link sm" bindtap="goRecord" hover-class="is-pressed">查看全部 ›</view>
      </view>
      <view class="caption" wx:if="{{dailyText}}">护理：{{dailyText}}</view>
      <empty
        wx:if="{{!shownLedger.length}}"
        compact
        icon="note"
        tone="note"
        title="今天还没记"
        hint="点上面的按钮记一笔。"
        elder="{{elder}}"
      />
      <view
        class="timeline-row"
        wx:for="{{shownLedger}}"
        wx:key="key"
        data-kind="{{item.kind}}"
        data-id="{{item.id}}"
        data-type="{{item.type}}"
        bindtap="openLine"
        hover-class="is-pressed"
      >
        <view class="timeline-clock">{{item.timeText}}</view>
        <view class="bubble sm tone-{{item.tone}}">
          <icon name="{{item.icon}}" size="{{32}}" elder="{{elder}}" />
        </view>
        <view class="timeline-body">
          <view class="timeline-title">{{item.text}}</view>
          <view class="timeline-meta" wx:if="{{item.memberName}}">{{item.memberName}}</view>
        </view>
        <text class="timeline-chev">›</text>
      </view>
    </view>
  </block>
</view>
