<view class="page tab {{elder ? 'elder' : ''}}">
  <block wx:if="{{loading}}">
    <view class="skeleton-card">
      <view class="skeleton-line w-40"></view>
      <view class="skeleton-line"></view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-line w-70"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line"></view>
    </view>
  </block>

  <view wx:elif="{{pageError}}" class="card error-state">
    <view class="heading">还没连上云</view>
    <view class="caption mt-1">{{pageError}}</view>
    <button class="btn btn-primary btn-block" hover-class="is-pressed" bindtap="retry">再试一次</button>
  </view>

  <view wx:elif="{{needBaby}}" class="card">
    <empty
      icon="baby"
      tone="sleep"
      title="先建立宝宝档案"
      hint="有了出生日，才能按阶段汇总。"
      action-text="去填写"
      elder="{{elder}}"
      bind:action="goBaby"
    />
  </view>

  <block wx:else>
    <view class="segmented mb-3">
      <view
        class="segmented-item {{span === 7 ? 'on' : ''}}"
        data-span="7"
        bindtap="onSpan"
        hover-class="is-pressed"
      >近 7 天</view>
      <view
        class="segmented-item {{span === 30 ? 'on' : ''}}"
        data-span="30"
        bindtap="onSpan"
        hover-class="is-pressed"
      >近 30 天</view>
    </view>
    <view class="caption mb-3">上面是这段时间一共多少。某一天的明细，点下面的日期。</view>

    <view class="card">
      <view class="section-head">
        <view class="section-title">近 {{span}} 天一共</view>
      </view>
      <view class="sum-row" wx:for="{{lines}}" wx:key="label">
        <text class="sum-label">{{item.label}}</text>
        <text class="sum-value num">{{item.value}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{days.length}}">
      <view class="section-head">
        <view class="section-title">选一天</view>
      </view>
      <view
        class="list-row"
        wx:for="{{days}}"
        wx:key="day"
        data-day="{{item.day}}"
        bindtap="openDay"
        hover-class="is-pressed"
      >
        <view class="list-text">
          <view class="list-title">{{item.pretty}}</view>
          <view class="list-sub" wx:if="{{!item.marked}}">还没记</view>
        </view>
        <text class="list-chev">›</text>
      </view>
    </view>

    <button class="btn btn-secondary btn-block" hover-class="is-pressed" bindtap="goExport">导出给医生看</button>
  </block>
</view>
