<view class="page tab {{elder ? 'elder' : ''}} {{settled ? 'settled' : ''}}">
  <block wx:if="{{loading}}">
    <view class="skeleton-card">
      <view class="skeleton-line w-40"></view>
      <view class="skeleton-line"></view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-line w-70"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line"></view>
    </view>
  </block>

  <view wx:elif="{{pageError}}" class="card error-state">
    <view class="heading">还没连上云</view>
    <view class="caption mt-1">{{pageError}}</view>
    <button class="btn btn-primary btn-block" hover-class="is-pressed" bindtap="retry">再试一次</button>
  </view>

  <view wx:elif="{{needBaby}}" class="card">
    <empty
      icon="baby"
      tone="sleep"
      title="先建立宝宝档案"
      hint="有了出生日，才知道这个阶段该记哪些。"
      action-text="去填写"
      elder="{{elder}}"
      bind:action="goBaby"
    />
  </view>

  <block wx:else>
    <view class="datebar">
      <view class="date-btn" bindtap="shift" data-dir="-1" hover-class="is-pressed">‹</view>
      <picker class="grow" mode="date" value="{{day}}" bindchange="onDate">
        <view class="datebar-main">{{pretty}}<text class="chev">›</text></view>
      </picker>
      <view class="date-btn" bindtap="shift" data-dir="1" hover-class="is-pressed">›</view>
    </view>
    <view class="text-center" wx:if="{{!isToday}}">
      <view class="link sm" bindtap="goToday" hover-class="is-pressed">回到今天</view>
    </view>

    <view class="day-stack {{isToday ? '' : 'history'}}">
    <view class="card day-actions">
      <view class="card-head">
        <view class="card-title">记一笔</view>
      </view>
      <view class="tool-grid">
        <view
          class="tool-tile"
          wx:for="{{actions}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onAction"
          hover-class="is-pressed"
        >
          <view class="tool-icon tone-{{item.tone}}">
            <icon name="{{item.icon}}" size="{{32}}" elder="{{elder}}" />
          </view>
          <view class="tool-label">{{item.title}}</view>
        </view>
      </view>

      <block wx:if="{{more.length}}">
        <view class="collapse-head {{showMore ? 'open' : ''}}" bindtap="toggleMore" hover-class="is-pressed">
          {{showMore ? '收起' : '还要记喂奶或尿布'}}
          <text class="chev">›</text>
        </view>
        <view wx:if="{{showMore}}" class="tool-grid">
          <view
            class="tool-tile"
            wx:for="{{more}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onAction"
            hover-class="is-pressed"
          >
            <view class="tool-icon tone-{{item.tone}}">
              <icon name="{{item.icon}}" size="{{32}}" elder="{{elder}}" />
            </view>
            <view class="tool-label">{{item.title}}</view>
          </view>
        </view>
      </block>
    </view>

    <view class="card day-summary">
      <view class="card-head">
        <view class="card-title">这一天</view>
      </view>
      <view class="kv-grid">
        <view class="kv-item">
          <text class="kv-label">总奶量</text>
          <text class="kv-value">{{totalMlText}}</text>
        </view>
        <view class="kv-item">
          <text class="kv-label">瓶喂母乳</text>
          <text class="kv-value">{{breastMlText}}</text>
        </view>
        <view class="kv-item">
          <text class="kv-label">配方奶</text>
          <text class="kv-value">{{formulaText}}</text>
        </view>
        <view class="kv-item">
          <text class="kv-label">亲喂</text>
          <text class="kv-value">{{breastText}}</text>
        </view>
        <view class="kv-item">
          <text class="kv-label">大便</text>
          <text class="kv-value">{{poopText}}</text>
        </view>
        <view class="kv-item">
          <text class="kv-label">尿布</text>
          <text class="kv-value">{{diaperText}}</text>
        </view>
        <view class="kv-item">
          <text class="kv-label">睡眠</text>
          <text class="kv-value">{{sleepText}}</text>
        </view>
        <view class="kv-item">
          <text class="kv-label">用药</text>
          <text class="kv-value">{{medText}}</text>
        </view>
        <view class="kv-item" wx:if="{{tempCount}}">
          <text class="kv-label">体温 · {{tempCount}} 次</text>
          <text class="kv-value">{{tempText}}</text>
        </view>
        <view class="kv-item" wx:if="{{jaundiceCount}}">
          <text class="kv-label">黄疸 · {{jaundiceCount}} 次</text>
          <text class="kv-value">{{jaundiceText}}</text>
        </view>
      </view>
    </view>

    <view class="card day-flow">
      <view class="card-head">
        <view class="card-title">流水</view>
        <view class="pill skip" wx:if="{{ledger.length}}">{{ledger.length}} 条</view>
      </view>
      <view class="caption">点一条可以修改。用药会打开这一天的用药页。</view>
      <empty
        wx:if="{{!ledger.length}}"
        compact
        icon="record"
        tone="note"
        title="这一天还没有记录"
        hint="点上面的按钮记一笔。"
        elder="{{elder}}"
      />
      <view
        class="timeline-row"
        wx:for="{{ledger}}"
        wx:key="key"
        data-kind="{{item.kind}}"
        data-id="{{item.id}}"
        data-type="{{item.type}}"
        bindtap="openLine"
        hover-class="is-pressed"
        style="animation-delay: {{index * 40 + 220}}ms"
      >
        <view class="timeline-clock">{{item.timeText}}</view>
        <view class="bubble sm tone-{{item.tone}}">
          <icon name="{{item.icon}}" size="{{40}}" elder="{{elder}}" />
        </view>
        <view class="timeline-body">
          <view class="timeline-title">{{item.text}}</view>
          <view class="timeline-meta" wx:if="{{item.memberName}}">{{item.memberName}}</view>
        </view>
        <text class="timeline-chev">›</text>
      </view>
    </view>
    </view>
  </block>
</view>
