<view class="page {{elder ? 'elder' : ''}}">
  <block wx:if="{{loading}}">
    <view class="skeleton-card">
      <view class="skeleton-line w-40"></view>
      <view class="skeleton-line"></view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-line w-70"></view>
      <view class="skeleton-line"></view>
    </view>
  </block>

  <view wx:elif="{{pageError}}" class="card error-state">
    <view class="heading">还没连上云</view>
    <view class="caption mt-1">{{pageError}}</view>
    <button class="btn btn-primary btn-block" hover-class="is-pressed" bindtap="retry">再试一次</button>
  </view>

  <block wx:else>
    <view class="page-head">
      <view class="page-head-main">
        <view class="display">家庭</view>
        <view class="caption mt-1">把邀请码发给家人，大家记同一本账。</view>
      </view>
      <view class="avatar lg tone-family"><icon name="family" size="{{56}}" elder="{{elder}}" /></view>
    </view>

    <view class="card">
      <view class="caption">邀请码</view>
      <view class="code mt-1">{{inviteCode}}</view>
      <view class="caption mt-2">爷爷奶奶用自己的微信打开小程序，输入这 6 位。不要发到大群。</view>
      <button class="btn btn-primary btn-block mt-3" hover-class="is-pressed" bindtap="copy">复制邀请码</button>
      <button
        wx:if="{{isOwner}}"
        class="btn btn-secondary btn-block mt-2"
        hover-class="is-pressed"
        bindtap="renew"
      >换一个邀请码</button>
    </view>

    <view class="card">
      <view class="section-head">
        <view class="section-title">家人</view>
      </view>
      <view class="list-row" wx:for="{{members}}" wx:key="_id" style="animation-delay: {{index * 40 + 100}}ms">
        <view class="list-text">
          <view class="list-title">
            {{item.label}}
            <text class="pill done ml-1" wx:if="{{item.isOwner}}">创建人</text>
            <text class="pill skip ml-1" wx:if="{{item.isMe}}">我</text>
          </view>
          <view class="list-sub" wx:if="{{item.roleName}}">{{item.roleName}}</view>
        </view>
        <button
          wx:if="{{isOwner && !item.isMe}}"
          class="btn-text danger"
          data-id="{{item._id}}"
          data-label="{{item.label}}"
          catchtap="remove"
        >移出</button>
      </view>
    </view>

    <view class="card">
      <view class="heading mb-3">加入别人的家庭</view>
      <view class="caption">只有还没建宝宝档案时可以加入。已经有档案的话，把你的邀请码发给对方。</view>
      <view class="field mt-3">
        <text class="label">6 位邀请码</text>
        <input
          class="input {{joinError ? 'is-error' : ''}}"
          type="number"
          maxlength="6"
          value="{{code}}"
          bindinput="onCode"
          placeholder="6 位数字"
          placeholder-class="input-ph"
        />
        <text class="field-error" wx:if="{{joinError}}">{{joinError}}</text>
      </view>
      <button class="btn btn-secondary btn-block" hover-class="is-pressed" bindtap="join">加入</button>
    </view>

    <view class="danger-zone" wx:if="{{!isOwner}}">
      <button class="btn-text danger" bindtap="leave">退出这个家庭</button>
    </view>

    <view class="footnote">吃药的微信提醒要每个人自己点一次允许，爷爷奶奶的手机才会响。</view>
  </block>
</view>
