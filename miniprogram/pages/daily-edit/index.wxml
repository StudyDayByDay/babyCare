<view class="page {{elder ? 'elder' : ''}}">
  <picker mode="date" value="{{day}}" bindchange="onDay">
    <view class="card">
      <view class="muted">这一天</view>
      <view class="h1">{{day}}</view>
    </view>
  </picker>
  <view class="card">
    <view class="field">
      <text class="label">精神状态</text>
      <view class="chips">
        <view class="chip {{mood === item ? 'on' : ''}}" wx:for="{{moods}}" wx:key="*this" data-value="{{item}}" bindtap="onMood">{{item}}</view>
      </view>
    </view>
    <view class="field">
      <text class="label">补剂</text>
      <view class="muted">勾选表示今天吃过，不代表该不该吃。</view>
      <view class="chips">
        <view class="chip {{supplements.vd ? 'on' : ''}}" data-key="vd" bindtap="onSup">维生素D</view>
        <view class="chip {{supplements.ad ? 'on' : ''}}" data-key="ad" bindtap="onSup">AD</view>
        <view class="chip {{supplements.custom[item] ? 'on' : ''}}" wx:for="{{customNames}}" wx:key="*this" data-key="{{item}}" bindtap="onCustom">{{item}}</view>
      </view>
    </view>
  </view>
  <view class="card">
    <view class="field">
      <text class="label">护理</text>
      <view class="chips">
        <view class="chip {{care[item.key] ? 'on' : ''}}" wx:for="{{careItems}}" wx:key="key" data-key="{{item.key}}" bindtap="onCare">{{item.label}}</view>
      </view>
    </view>
    <view class="field" wx:if="{{showEdu}}">
      <text class="label">早教打卡</text>
      <view class="chips">
        <view class="chip {{earlyEdu[item.key] ? 'on' : ''}}" wx:for="{{eduItems}}" wx:key="key" data-key="{{item.key}}" bindtap="onEdu">{{item.label}}</view>
      </view>
    </view>
    <view class="field" wx:if="{{showTummy}}">
      <text class="label">俯卧</text>
      <stepper elder="{{elder}}" value="{{tummyMin}}" min="{{0}}" max="{{180}}" step="{{1}}" unit="分钟" bind:change="onTummy" />
    </view>
  </view>
  <view class="card" wx:if="{{showNewborn}}">
    <view class="field">
      <text class="label">黄疸（看到的情况）</text>
      <view class="chips">
        <view class="chip {{jaundice === item ? 'on' : ''}}" wx:for="{{jaundiceOptions}}" wx:key="*this" data-value="{{item}}" bindtap="onJaundice">{{item}}</view>
      </view>
    </view>
    <view class="field">
      <text class="label">脐带</text>
      <view class="chips">
        <view class="chip {{umbilical === item ? 'on' : ''}}" wx:for="{{umbilicalOptions}}" wx:key="*this" data-value="{{item}}" bindtap="onUmbilical">{{item}}</view>
      </view>
    </view>
  </view>
  <view class="card">
    <view class="field">
      <text class="label">天气（可不填）</text>
      <input class="input" value="{{weather}}" bindinput="onWeather" placeholder="晴" />
    </view>
    <view class="field">
      <text class="label">今天的话</text>
      <textarea class="textarea" value="{{note}}" bindinput="onNote" placeholder="想留的纪念，也可以空着" />
    </view>
  </view>
  <button class="btn btn-primary btn-block" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存这一天</button>
</view>
