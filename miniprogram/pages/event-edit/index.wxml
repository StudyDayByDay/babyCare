<view class="page form {{elder ? 'elder' : ''}}">
  <block wx:if="{{loading}}">
    <view class="skeleton-card">
      <view class="skeleton-line w-40"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line w-70"></view>
    </view>
  </block>

  <view wx:elif="{{pageError}}" class="card error-state">
    <view class="heading">还没连上云</view>
    <view class="caption mt-1">{{pageError}}</view>
    <button class="btn btn-primary btn-block" hover-class="is-pressed" bindtap="retry">再试一次</button>
  </view>

  <block wx:else>
    <view class="page-head">
      <view class="page-head-main">
        <view class="display">{{title}}</view>
        <view class="caption mt-1">{{typeHint}}</view>
      </view>
      <view class="bubble lg tone-{{tone}}"><icon name="{{icon}}" size="{{56}}" elder="{{elder}}" /></view>
    </view>

    <view wx:if="{{formError}}" class="form-alert">{{formError}}</view>

    <view class="card" wx:if="{{type === 'sleep'}}">
      <view class="field">
        <text class="label">开始</text>
        <view class="pair">
          <view class="pair-item">
            <picker mode="date" value="{{startDay}}" bindchange="onPick" data-field="startDay">
              <view class="input picker-face">{{startDay}}<text class="chev">›</text></view>
            </picker>
          </view>
          <view class="pair-item">
            <picker mode="time" value="{{startTime}}" bindchange="onPick" data-field="startTime">
              <view class="input picker-face">{{startTime}}<text class="chev">›</text></view>
            </picker>
          </view>
        </view>
      </view>
      <view class="field">
        <text class="label">结束</text>
        <view class="pair">
          <view class="pair-item">
            <picker mode="date" value="{{endDay}}" bindchange="onPick" data-field="endDay">
              <view class="input picker-face">{{endDay}}<text class="chev">›</text></view>
            </picker>
          </view>
          <view class="pair-item">
            <picker mode="time" value="{{endTime}}" bindchange="onPick" data-field="endTime">
              <view class="input picker-face">{{endTime}}<text class="chev">›</text></view>
            </picker>
          </view>
        </view>
        <view class="muted mt-1">结束早于开始时，按第二天计算。</view>
      </view>
      <view class="caption" wx:if="{{sleepDuration}}">这次睡了 {{sleepDuration}}</view>
      <view class="field">
        <text class="label">头朝向</text>
        <view class="chips">
          <view
            class="chip {{direction === item ? 'on' : ''}}"
            wx:for="{{directions}}"
            wx:key="*this"
            data-field="direction"
            data-value="{{item}}"
            bindtap="onChip"
            hover-class="is-pressed"
          >{{item}}</view>
        </view>
      </view>
    </view>

    <view class="card" wx:else>
      <view class="pair">
        <view class="pair-item">
          <text class="label">日期</text>
          <picker mode="date" value="{{day}}" bindchange="onPick" data-field="day">
            <view class="input picker-face">{{day}}<text class="chev">›</text></view>
          </picker>
        </view>
        <view class="pair-item">
          <text class="label">时间</text>
          <picker mode="time" value="{{time}}" bindchange="onPick" data-field="time">
            <view class="input picker-face">{{time}}<text class="chev">›</text></view>
          </picker>
        </view>
      </view>
      <view class="chips mt-2">
        <view class="chip {{timePreset === 'now' ? 'on' : ''}}" data-min="0" data-preset="now" bindtap="setAgo" hover-class="is-pressed">现在</view>
        <view class="chip {{timePreset === '5' ? 'on' : ''}}" data-min="5" data-preset="5" bindtap="setAgo" hover-class="is-pressed">5 分钟前</view>
        <view class="chip {{timePreset === '30' ? 'on' : ''}}" data-min="30" data-preset="30" bindtap="setAgo" hover-class="is-pressed">半小时前</view>
      </view>
    </view>

    <view class="card" wx:if="{{type === 'feed'}}">
      <view class="heading mb-3">亲喂</view>
      <view class="field">
        <text class="label">左侧</text>
        <stepper elder="{{elder}}" value="{{leftMin}}" min="{{0}}" max="{{180}}" step="{{1}}" unit="分钟" bind:change="onStep" data-field="leftMin" />
      </view>
      <view class="field">
        <text class="label">右侧</text>
        <stepper elder="{{elder}}" value="{{rightMin}}" min="{{0}}" max="{{180}}" step="{{1}}" unit="分钟" bind:change="onStep" data-field="rightMin" />
      </view>
      <view class="heading mb-3 mt-4">瓶喂</view>
      <view class="field">
        <text class="label">瓶喂母乳</text>
        <stepper elder="{{elder}}" value="{{bottleBreastMl}}" min="{{0}}" max="{{500}}" step="{{5}}" unit="毫升" presets="60,90,120,150" bind:change="onStep" data-field="bottleBreastMl" />
      </view>
      <view class="field">
        <text class="label">配方奶</text>
        <stepper elder="{{elder}}" value="{{formulaMl}}" min="{{0}}" max="{{500}}" step="{{5}}" unit="毫升" presets="60,90,120,150" bind:change="onStep" data-field="formulaMl" />
      </view>
      <view class="field">
        <text class="label">吐奶</text>
        <view class="chips">
          <view
            class="chip {{spit === item ? 'on' : ''}}"
            wx:for="{{spits}}"
            wx:key="*this"
            data-field="spit"
            data-value="{{item}}"
            bindtap="onChip"
            hover-class="is-pressed"
          >{{item}}</view>
        </view>
      </view>
      <view class="caption" wx:if="{{feedSummary}}">这次：{{feedSummary}}</view>
    </view>

    <view class="card" wx:if="{{type === 'diaper'}}">
      <view class="field">
        <text class="label">这一次</text>
        <view class="segmented">
          <view class="segmented-item {{diaperKind === 'pee' ? 'on' : ''}}" data-kind="pee" bindtap="onDiaperKind" hover-class="is-pressed">小便</view>
          <view class="segmented-item {{diaperKind === 'poop' ? 'on' : ''}}" data-kind="poop" bindtap="onDiaperKind" hover-class="is-pressed">大便</view>
          <view class="segmented-item {{diaperKind === 'both' ? 'on' : ''}}" data-kind="both" bindtap="onDiaperKind" hover-class="is-pressed">都有</view>
        </view>
      </view>
      <block wx:if="{{poop}}">
        <view class="field">
          <text class="label">颜色</text>
          <view class="chips">
            <view
              class="chip {{color === item.value ? 'on' : ''}}"
              wx:for="{{colors}}"
              wx:key="value"
              data-field="color"
              data-value="{{item.value}}"
              bindtap="onChip"
              hover-class="is-pressed"
            ><view class="chip-dot dot-{{item.tone}}"></view>{{item.value}}</view>
          </view>
          <view class="muted mt-1">白陶土、血丝记下来给医生看。看到了请尽快联系医生。</view>
        </view>
        <view class="field">
          <text class="label">性状</text>
          <view class="chips">
            <view
              class="chip {{texture === item ? 'on' : ''}}"
              wx:for="{{textures}}"
              wx:key="*this"
              data-field="texture"
              data-value="{{item}}"
              bindtap="onChip"
              hover-class="is-pressed"
            >{{item}}</view>
          </view>
        </view>
        <view class="field">
          <text class="label">量</text>
          <view class="chips">
            <view
              class="chip {{amount === item ? 'on' : ''}}"
              wx:for="{{amounts}}"
              wx:key="*this"
              data-field="amount"
              data-value="{{item}}"
              bindtap="onChip"
              hover-class="is-pressed"
            >{{item}}</view>
          </view>
        </view>
      </block>
    </view>

    <view class="card" wx:if="{{type === 'temp'}}">
      <view class="field">
        <text class="label">体温</text>
        <view class="display text-center mb-3">{{celsius}}℃</view>
        <stepper elder="{{elder}}" value="{{celsius}}" min="{{34}}" max="{{42}}" step="{{0.1}}" unit="℃" bind:change="onStep" data-field="celsius" />
        <view class="chips mt-2">
          <view class="chip" data-value="36.5" bindtap="setTemp" hover-class="is-pressed">36.5</view>
          <view class="chip" data-value="37.0" bindtap="setTemp" hover-class="is-pressed">37.0</view>
          <view class="chip" data-value="38.0" bindtap="setTemp" hover-class="is-pressed">38.0</view>
        </view>
      </view>
      <view class="muted">只记录测到的数字。</view>
    </view>

    <view class="card" wx:if="{{type === 'solid'}}">
      <view class="field">
        <text class="label required">吃了什么</text>
        <input
          class="input"
          value="{{solidName}}"
          bindinput="onInput"
          data-field="solidName"
          placeholder="例如米糊"
          placeholder-class="input-ph"
        />
      </view>
      <view class="field">
        <text class="label">形态</text>
        <view class="chips">
          <view
            class="chip {{foodTexture === item ? 'on' : ''}}"
            wx:for="{{foodTextures}}"
            wx:key="*this"
            data-field="foodTexture"
            data-value="{{item}}"
            bindtap="onChip"
            hover-class="is-pressed"
          >{{item}}</view>
        </view>
      </view>
      <view class="field">
        <text class="label">量（可不填）</text>
        <input
          class="input"
          value="{{amountText}}"
          bindinput="onInput"
          data-field="amountText"
          placeholder="两勺、半碗"
          placeholder-class="input-ph"
        />
      </view>
      <view class="field">
        <view
          class="chip {{isNew ? 'on' : ''}}"
          bindtap="onToggle"
          data-field="isNew"
          hover-class="is-pressed"
        >第一次吃这个</view>
      </view>
      <view class="field">
        <text class="label">接受情况</text>
        <view class="chips">
          <view
            class="chip {{reaction === item ? 'on' : ''}}"
            wx:for="{{reactions}}"
            wx:key="*this"
            data-field="reaction"
            data-value="{{item}}"
            bindtap="onChip"
            hover-class="is-pressed"
          >{{item}}</view>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{type === 'milestone'}}">
      <view class="field">
        <text class="label required">选一个，或自己写</text>
        <view class="chips">
          <view
            class="chip {{milestone === item ? 'on' : ''}}"
            wx:for="{{presets}}"
            wx:key="*this"
            data-field="milestone"
            data-value="{{item}}"
            bindtap="onChip"
            hover-class="is-pressed"
          >{{item}}</view>
        </view>
      </view>
      <view class="field">
        <input
          class="input"
          value="{{milestone}}"
          bindinput="onInput"
          data-field="milestone"
          placeholder="或自己写"
          placeholder-class="input-ph"
        />
      </view>
      <view class="muted" wx:if="{{hint}}">{{hint}}</view>
    </view>

    <view class="card" wx:if="{{type === 'note'}}">
      <view class="field">
        <text class="label">哪一类</text>
        <view class="chips">
          <view
            class="chip {{category === item ? 'on' : ''}}"
            wx:for="{{categories}}"
            wx:key="*this"
            data-field="category"
            data-value="{{item}}"
            bindtap="onChip"
            hover-class="is-pressed"
          >{{item}}</view>
        </view>
      </view>
      <view class="field">
        <text class="label required">记下这次</text>
        <textarea
          class="textarea"
          value="{{noteText}}"
          bindinput="onInput"
          data-field="noteText"
          placeholder="症状、医生原话。不写判断。"
          placeholder-class="input-ph"
        />
      </view>
    </view>

    <view class="card" wx:if="{{type === 'feed' || type === 'diaper' || type === 'sleep' || type === 'solid'}}">
      <view class="field">
        <text class="label">备注</text>
        <input
          class="input"
          value="{{note}}"
          bindinput="onInput"
          data-field="note"
          placeholder="可不填"
          placeholder-class="input-ph"
        />
      </view>
    </view>

    <view wx:if="{{recordId}}" class="danger-zone">
      <button class="btn-text danger" bindtap="remove">删除这条记录</button>
    </view>
  </block>

  <view class="save-bar" wx:if="{{!loading && !pageError}}">
    <button
      class="btn btn-primary btn-block"
      hover-class="is-pressed"
      loading="{{saving}}"
      disabled="{{saving}}"
      bindtap="save"
    >保存</button>
  </view>
</view>
