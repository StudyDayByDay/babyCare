.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--sp-4, 32rpx) var(--sp-2, 16rpx);
}
.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--sp-2, 16rpx);
}
.empty.compact {
  padding: var(--sp-3, 24rpx) var(--sp-2, 16rpx);
}
.empty.compact .empty-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
}
.empty-title {
  font-size: var(--fs-heading, 32rpx);
  font-weight: 700;
  color: var(--ink, #2E2428);
}
.empty-hint {
  margin-top: var(--sp-1, 8rpx);
  max-width: 520rpx;
  font-size: var(--fs-caption, 24rpx);
  line-height: 1.5;
  color: var(--ink-3, #6F6368);
}
.empty-btn {
  margin-top: var(--sp-2, 16rpx);
}
.empty.elder .empty-title {
  font-size: 38rpx;
}
.empty.elder .empty-hint {
  font-size: 30rpx;
}
