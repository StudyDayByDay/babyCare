<view class="page tab {{elder ? 'elder' : ''}} {{settled ? 'settled' : ''}}">
  <block wx:if="{{loading}}">
    <view class="skeleton-card">
      <view class="skeleton-line w-40"></view>
      <view class="skeleton-line"></view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-line w-70"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line"></view>
    </view>
  </block>

  <view wx:elif="{{pageError}}" class="card error-state">
    <view class="heading">还没连上云</view>
    <view class="caption mt-1">{{pageError}}</view>
    <button class="btn btn-primary btn-block" hover-class="is-pressed" bindtap="retry">再试一次</button>
  </view>

  <view wx:elif="{{needBaby}}" class="card">
    <empty
      icon="baby"
      tone="sleep"
      title="先建立宝宝档案"
      hint="有了出生日，才能按阶段汇总。"
      action-text="去填写"
      elder="{{elder}}"
      bind:action="goBaby"
    />
  </view>

  <block wx:else>
    <view class="segmented mb-3">
      <view
        class="segmented-item {{span === 7 ? 'on' : ''}}"
        data-span="7"
        bindtap="onSpan"
        hover-class="is-pressed"
      >近 7 天</view>
      <view
        class="segmented-item {{span === 30 ? 'on' : ''}}"
        data-span="30"
        bindtap="onSpan"
        hover-class="is-pressed"
      >近 30 天</view>
    </view>
    <view class="caption mb-3">这是合计和趋势，不判断正不正常。点任意一根柱子打开那一天的明细。</view>

    <view class="card" wx:if="{{hasData}}">
      <view class="card-head">
        <view class="card-title">趋势</view>
        <view class="sub">近 {{span}} 天</view>
      </view>
      <view class="segmented sm mt-2">
        <view
          class="segmented-item {{chartMetric === 'feed' ? 'on' : ''}}"
          data-metric="feed"
          bindtap="onChartMetric"
          hover-class="is-pressed"
        >喂奶</view>
        <view
          class="segmented-item {{chartMetric === 'diaper' ? 'on' : ''}}"
          data-metric="diaper"
          bindtap="onChartMetric"
          hover-class="is-pressed"
        >尿布</view>
        <view
          class="segmented-item {{chartMetric === 'poop' ? 'on' : ''}}"
          data-metric="poop"
          bindtap="onChartMetric"
          hover-class="is-pressed"
        >大便</view>
        <view
          class="segmented-item {{chartMetric === 'sleep' ? 'on' : ''}}"
          data-metric="sleep"
          bindtap="onChartMetric"
          hover-class="is-pressed"
        >睡眠</view>
      </view>
      <view class="chart">
        <view class="chart-row" style="{{span === 30 ? 'height: 160rpx;' : ''}}">
          <view
            class="chart-col"
            wx:for="{{chart}}"
            wx:key="day"
            data-day="{{item.day}}"
            bindtap="openChartDay"
          >
            <view class="chart-value" wx:if="{{item.value}}">{{item.value}}</view>
            <view class="chart-track">
              <view class="chart-bar {{item.percent ? '' : 'zero'}} {{item.isToday ? 'today' : ''}}" style="height: {{item.percent}}%;"></view>
            </view>
            <view class="chart-label {{item.isToday ? 'today' : ''}}">{{item.label}}</view>
          </view>
        </view>
      </view>
      <view class="chart-range">{{chartRange}}</view>
      <view class="chart-summary">
        <view class="chart-summary-item">
          <view class="eyebrow">总计</view>
          <view class="chart-summary-value">{{chartTotal}}</view>
        </view>
        <view class="chart-summary-item">
          <view class="eyebrow">日均</view>
          <view class="chart-summary-value">{{chartAvg}}</view>
        </view>
        <view class="chart-summary-item">
          <view class="eyebrow">最高</view>
          <view class="chart-summary-value">{{chartMax}}</view>
        </view>
      </view>
    </view>

    <view class="card" wx:else>
      <empty
        icon="stats"
        tone="solid"
        title="这段时间还没有记录"
        hint="先记几天，再回来看看趋势。"
        action-text="去记一笔"
        elder="{{elder}}"
        bind:action="goRecord"
      />
    </view>

    <view class="card" wx:if="{{hasData && markedDays.length}}">
      <view class="card-head">
        <view class="card-title">有记录的天</view>
        <view class="sub">{{markedDays.length}} 天</view>
      </view>
      <view
        class="list-row"
        wx:for="{{markedDays}}"
        wx:key="day"
        data-day="{{item.day}}"
        bindtap="openDay"
        hover-class="is-pressed"
      >
        <view class="list-text">
          <view class="list-title">{{item.pretty}}</view>
        </view>
        <text class="list-chev">›</text>
      </view>
    </view>

    <button class="btn btn-secondary btn-block" hover-class="is-pressed" bindtap="goExport">导出给医生看</button>
  </block>
</view>
