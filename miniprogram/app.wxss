/* ============================================================
   BabyCare design tokens — 奶油 · 玫瑰 · 鼠尾草
   所有颜色、字号、间距、圆角只从这里取。
   白字实心按钮用 --brand-strong；--accent 只做提醒和点缀。
   ============================================================ */
page {
  /* color */
  --bg: #FBF6F1;
  --surface: #FFFFFF;
  --surface-2: #F5EEE8;
  --surface-3: #EDE3DB;
  --line: #EAE0D8;
  --control-line: #94857C;
  --ink: #2E2428;
  --ink-2: #62565C;
  --ink-3: #6F6368;
  --brand: #B06A75;
  --brand-strong: #9F5563;
  --brand-ink: #8C4553;
  --brand-soft: #F7E9EC;
  --brand-tint: #EBCFD5;
  --brand-tint-strong: #D9B4BD;
  --accent: #B07A2A;
  --accent-strong: #8F5F12;
  --accent-ink: #7A5008;
  --accent-soft: #FBF1D8;
  --accent-tint: #EAD9AE;
  --gold: #C9973F;
  --gold-light: #E8C06A;
  --gold-ink: #7A5A00;
  --gold-soft: #FBF1D8;
  --gold-tint: #EAD9AE;
  --sage: #5F7F62;
  --sage-deep: #3F5F44;
  --sage-soft: #E9F0E8;
  --danger: #B23A46;
  --danger-soft: #FBEAEC;

  /* type */
  --fs-display: 52rpx;
  --fs-title: 40rpx;
  --fs-heading: 32rpx;
  --fs-body: 30rpx;
  --fs-label: 28rpx;
  --fs-caption: 24rpx;
  --fs-eyebrow: 24rpx;

  /* spacing */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 48rpx;
  --page-x: 32rpx;

  /* radius / shadow */
  --r-card: 24rpx;
  --r-control: 16rpx;
  --r-icon: 16rpx;
  --r-btn: 16rpx;
  --r-pill: 999rpx;
  --shadow-card: 0 1rpx 2rpx rgba(46, 36, 40, 0.04);
  --shadow-raised: 0 16rpx 40rpx rgba(46, 36, 40, 0.14);
  --shadow-bar: 0 -1rpx 0 rgba(46, 36, 40, 0.06);

  /* controls / tap targets */
  --tap-min: 88rpx;
  --control-h: 96rpx;
  --btn-h: 96rpx;
  --chip-h: 80rpx;
  --tabbar-h: 120rpx;
  --savebar-h: 128rpx;
  --row-h: 96rpx;
  --timeline-h: 128rpx;
  --bubble: 64rpx;
  --bubble-sm: 48rpx;
  --board-avatar: 72rpx;

  /* category tones */
  --tone-feed: #EAF2F6;
  --tone-diaper: #F7F0E4;
  --tone-sleep: #F1ECF5;
  --tone-care: #F9EDE8;
  --tone-temp: #F8ECF0;
  --tone-jaundice: #FAF3DE;
  --tone-solid: #F1F2E5;
  --tone-mile: #FAF3DF;
  --tone-note: #F4EFE8;
  --tone-med: #FBF1D8;
  --tone-growth: #E9F0E8;
  --tone-vaccine: #EAF2F6;
  --tone-family: #F4EDF5;
  --tone-export: #F2EEE9;

  background: var(--bg);
  color: var(--ink);
  font-size: var(--fs-body);
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.elder {
  --fs-display: 60rpx;
  --fs-title: 48rpx;
  --fs-heading: 38rpx;
  --fs-body: 36rpx;
  --fs-label: 34rpx;
  --fs-caption: 30rpx;
  --fs-eyebrow: 30rpx;
  --tap-min: 104rpx;
  --control-h: 112rpx;
  --btn-h: 112rpx;
  --chip-h: 96rpx;
  --tabbar-h: 140rpx;
  --savebar-h: 144rpx;
  --row-h: 104rpx;
  --timeline-h: 148rpx;
  --bubble: 72rpx;
  --bubble-sm: 56rpx;
  --board-avatar: 80rpx;
}

.tone-feed { background: var(--tone-feed); }
.tone-diaper { background: var(--tone-diaper); }
.tone-sleep { background: var(--tone-sleep); }
.tone-care { background: var(--tone-care); }
.tone-temp { background: var(--tone-temp); }
.tone-jaundice { background: var(--tone-jaundice); }
.tone-solid { background: var(--tone-solid); }
.tone-mile { background: var(--tone-mile); }
.tone-note { background: var(--tone-note); }
.tone-med { background: var(--tone-med); }
.tone-growth { background: var(--tone-growth); }
.tone-vaccine { background: var(--tone-vaccine); }
.tone-family { background: var(--tone-family); }
.tone-export { background: var(--tone-export); }

/* ---------- page shell ---------- */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--sp-4) var(--page-x) var(--sp-5);
  animation: page-in 0.3s ease-out both;
}
.page.tab {
  padding-bottom: calc(var(--tabbar-h) + var(--sp-5) + env(safe-area-inset-bottom));
}
.page.form {
  padding-bottom: calc(var(--savebar-h) + var(--sp-5) + env(safe-area-inset-bottom));
}

.page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-3);
  animation: fade-up 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.page-head-main {
  flex: 1;
  min-width: 0;
  padding-right: var(--sp-2);
}

/* ---------- typography ---------- */
.display {
  font-size: var(--fs-display);
  font-weight: 700;
  line-height: 1.15;
  color: var(--ink);
  overflow-wrap: anywhere;
  word-break: break-word;
}
.title {
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.2;
  color: var(--ink);
}
.heading {
  font-size: var(--fs-heading);
  font-weight: 700;
  line-height: 1.3;
  color: var(--ink);
}
.body {
  font-size: var(--fs-body);
  color: var(--ink);
}
.label {
  display: block;
  font-size: var(--fs-label);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: var(--sp-2);
}
.caption {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}
.muted {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}
.sub {
  font-size: var(--fs-caption);
  color: var(--ink-2);
}
.num {
  font-variant-numeric: tabular-nums;
}
.footnote {
  margin-top: var(--sp-3);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  line-height: 1.6;
}
.link {
  display: inline-flex;
  align-items: center;
  min-height: var(--tap-min);
  color: var(--brand-ink);
  font-size: var(--fs-label);
  font-weight: 600;
  transition: opacity 0.14s ease, transform 0.14s ease;
}

.chev {
  color: var(--ink-3);
  font-size: 40rpx;
  line-height: 1;
  margin-left: var(--sp-1);
}

/* ---------- layout helpers ---------- */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.grow {
  flex: 1;
  min-width: 0;
}
.gap {
  height: var(--sp-2);
}
.pair {
  display: flex;
}
.pair-item {
  flex: 1;
  min-width: 0;
}
.pair-item + .pair-item {
  margin-left: var(--sp-2);
}
.pair > .btn {
  flex: 1;
}
.pair > .btn + .btn {
  margin-left: var(--sp-2);
}
.dose-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
  font-size: var(--fs-body);
  line-height: 1.4;
  color: var(--ink);
}
.dose-name {
  flex: 1;
  min-width: 0;
}
.dose-amount {
  flex-shrink: 0;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.med-action {
  margin-top: var(--sp-4);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--line);
}
.card-accent .med-action {
  border-top-color: var(--gold-tint);
}
.mt-1 { margin-top: var(--sp-1); }
.mt-2 { margin-top: var(--sp-2); }
.mt-3 { margin-top: var(--sp-3); }
.mt-4 { margin-top: var(--sp-4); }
.ml-1 { margin-left: var(--sp-1); }
.ml-2 { margin-left: var(--sp-2); }
.mb-2 { margin-bottom: var(--sp-2); }
.mb-3 { margin-bottom: var(--sp-3); }
.text-center { text-align: center; }

/* ---------- cards ---------- */
.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-card);
  padding: var(--sp-4);
  margin-bottom: var(--sp-4);
  box-shadow: var(--shadow-card);
  animation: fade-up 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.card-accent {
  background: var(--accent-soft);
  border: 1rpx solid var(--accent-tint);
  box-shadow: none;
}
.card-flat {
  background: var(--surface-2);
  box-shadow: none;
}
.card > .section-head:first-child {
  margin-top: calc(var(--sp-1) * -1);
}
.divider {
  height: 1rpx;
  background: var(--line);
  margin: var(--sp-3) 0;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
}
.section-title {
  font-size: var(--fs-caption);
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--ink-2);
}
.card-title {
  font-size: var(--fs-heading);
  font-weight: 700;
  line-height: 1.25;
  color: var(--ink);
}
.eyebrow {
  font-size: var(--fs-eyebrow);
  font-weight: 600;
  letter-spacing: 1.5rpx;
  color: var(--ink-3);
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
}

/* ---------- buttons ---------- */
button.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: auto;
  min-height: var(--btn-h);
  margin: 0;
  padding: 0 var(--sp-4);
  border: 0;
  border-radius: var(--r-btn);
  background: var(--surface-2);
  color: var(--ink);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.2;
  transition: transform 0.14s ease, opacity 0.14s ease, background 0.2s ease;
}
button.btn::after {
  border: 0;
}
button.btn-primary {
  background: var(--brand-strong);
  color: #FFFFFF;
}
button.btn-primary.is-pressed,
button.btn-primary:active {
  background: var(--brand-ink);
}
button.btn-secondary {
  background: var(--brand-soft);
  color: var(--brand-ink);
}
button.btn-secondary.is-pressed,
button.btn-secondary:active {
  background: var(--brand-tint);
}
button.btn-ghost {
  background: transparent;
  border: 2rpx solid var(--control-line);
  color: var(--ink);
}
button.btn-ghost.is-pressed,
button.btn-ghost:active {
  background: var(--surface-2);
}
button.btn-danger {
  background: var(--danger);
  color: #FFFFFF;
}
button.btn-danger-ghost {
  background: var(--danger-soft);
  color: var(--danger);
}
button.btn-text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-height: var(--tap-min);
  margin: 0;
  padding: 0 var(--sp-2);
  border: 0;
  border-radius: var(--r-btn);
  background: transparent;
  color: var(--brand-ink);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.2;
}
button.btn-text::after {
  border: 0;
}
button.btn-text.danger {
  color: var(--danger);
}
button.btn-sm {
  min-height: var(--tap-min);
  padding: 0 var(--sp-3);
  font-size: var(--fs-label);
}
button.btn-block {
  display: flex;
  width: 100%;
}
button.btn-icon {
  width: var(--tap-min);
  min-width: var(--tap-min);
  height: var(--tap-min);
  min-height: var(--tap-min);
  padding: 0;
  border-radius: var(--r-pill);
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 36rpx;
  font-weight: 700;
}
button.btn[disabled] {
  opacity: 0.55;
}
.button-stack .btn + .btn {
  margin-top: var(--sp-2);
}
.is-pressed {
  opacity: 0.82;
  transform: scale(0.97);
}
.quick-card.is-pressed,
.stat-tile.is-pressed {
  transform: scale(0.965);
  opacity: 0.92;
}

/* ---------- forms ---------- */
.field {
  margin-bottom: var(--sp-4);
}
.field:last-child {
  margin-bottom: 0;
}
.label.required::after {
  content: " *";
  color: var(--brand-ink);
}
.input,
.textarea {
  display: block;
  width: 100%;
  box-sizing: border-box;
  background: var(--surface-2);
  border: 1rpx solid var(--control-line);
  border-radius: var(--r-control);
  color: var(--ink);
  font-size: var(--fs-body);
}
input.input,
view.input {
  height: var(--control-h);
  min-height: var(--control-h);
  line-height: var(--control-h);
  padding: 0 var(--sp-3);
}
.textarea {
  height: 180rpx;
  min-height: 180rpx;
  line-height: 1.5;
  padding: var(--sp-3);
}
.input-ph {
  color: var(--ink-3);
}
.picker-face {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.picker-face .chev {
  flex-shrink: 0;
}
.input.is-error {
  border-color: var(--danger);
}
.field-error {
  display: block;
  margin-top: var(--sp-1);
  color: var(--danger);
  font-size: var(--fs-caption);
}
.form-alert {
  background: var(--danger-soft);
  color: var(--danger);
  border-radius: var(--r-control);
  padding: var(--sp-2) var(--sp-3);
  font-size: var(--fs-label);
  margin-bottom: var(--sp-3);
}
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--tap-min);
}
.switch-copy {
  flex: 1;
  min-width: 0;
  padding-right: var(--sp-2);
}

/* ---------- chips / segmented ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  display: inline-flex;
  align-items: center;
  min-height: var(--chip-h);
  padding: 0 24rpx;
  margin: 0 var(--sp-2) var(--sp-2) 0;
  border-radius: 12rpx;
  background: var(--surface);
  border: 1rpx solid var(--control-line);
  color: var(--ink-2);
  font-size: var(--fs-label);
  line-height: 1.2;
  transition: transform 0.14s ease, opacity 0.14s ease, background 0.2s ease, color 0.2s ease;
}
.chip.on {
  background: var(--brand-strong);
  border-color: var(--brand-strong);
  color: #FFFFFF;
  font-weight: 600;
}
.chip.is-pressed {
  opacity: 0.8;
}
.chip-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.segmented {
  display: flex;
  padding: 4rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--surface-2);
  animation: fade-up 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.segmented-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  border-radius: 9rpx;
  color: var(--ink-2);
  font-size: var(--fs-label);
  font-weight: 600;
  transition: background 0.2s ease, color 0.2s ease, transform 0.14s ease;
}
.segmented-item.on {
  background: var(--surface);
  color: var(--ink);
  box-shadow: 0 1rpx 2rpx rgba(46, 36, 40, 0.08);
}
.segmented-item.is-pressed {
  opacity: 0.75;
}

/* ---------- bubbles ---------- */
.bubble {
  width: var(--bubble);
  height: var(--bubble);
  border-radius: var(--r-icon);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bubble.sm {
  width: var(--bubble-sm);
  height: var(--bubble-sm);
  border-radius: 14rpx;
}
.bubble.lg {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
}

/* ---------- stats ---------- */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}
.stat-grid.cols-1 {
  grid-template-columns: 1fr;
}
.stat-grid.cols-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.stat-grid.cols-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.stat-grid.cols-4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}
.elder .stat-grid.cols-3,
.elder .stat-grid.cols-4 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.stat-tile {
  min-width: 0;
  padding: 20rpx;
  border-radius: var(--r-control);
  background: var(--surface-2);
  box-sizing: border-box;
  animation: fade-up 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.stat-value {
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5rpx;
  color: var(--ink);
  overflow-wrap: anywhere;
  word-break: break-word;
  font-variant-numeric: tabular-nums;
}
.stat-value.compact {
  font-size: var(--fs-heading);
}
.stat-label {
  margin-top: var(--sp-1);
  font-size: var(--fs-eyebrow);
  font-weight: 600;
  color: var(--ink-3);
}

/* ---------- quick actions ---------- */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--sp-2);
}
.quick-grid.cols-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.elder .quick-grid {
  grid-template-columns: 1fr;
}
.elder .quick-grid.cols-3 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.elder .quick-card {
  min-height: 200rpx;
}
.elder .quick-grid.cols-3 .quick-card {
  min-height: 176rpx;
}
.quick-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 140rpx;
  padding: 20rpx;
  border-radius: var(--r-card);
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: none;
  overflow: hidden;
  animation: fade-up 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
  transition: transform 0.16s ease, opacity 0.16s ease, background 0.16s ease;
}
.quick-arrow {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  color: var(--ink-3);
  font-size: 32rpx;
  line-height: 1;
  opacity: 0.6;
}
.quick-card .bubble {
  margin-bottom: var(--sp-2);
}
.quick-title {
  font-size: var(--fs-label);
  font-weight: 600;
  color: var(--ink);
}
.quick-hint {
  margin-top: 4rpx;
  font-size: var(--fs-eyebrow);
  color: var(--ink-3);
}
.quick-grid.cols-3 .quick-card {
  align-items: center;
  text-align: center;
  min-height: 148rpx;
}
.quick-grid.cols-3 .bubble {
  margin-left: auto;
  margin-right: auto;
}
.page.night .quick-grid {
  grid-template-columns: 1fr;
}
.page.night .quick-card {
  display: grid;
  grid-template-columns: auto 1fr;
  grid-template-rows: auto auto;
  column-gap: var(--sp-3);
  align-items: center;
  min-height: 184rpx;
}
.page.night .quick-card .bubble {
  grid-row: 1 / span 2;
  margin-bottom: 0;
}
.page.night .quick-title {
  grid-column: 2;
}
.page.night .quick-hint {
  grid-column: 2;
  margin-top: 4rpx;
}
.page.night .quick-actions {
  grid-template-columns: 1fr;
}

.sum-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  min-height: var(--tap-min);
  padding: 12rpx 0;
  border-top: 1rpx solid var(--line);
}
.sum-row:first-child {
  border-top: none;
}
.sum-label {
  font-size: var(--fs-body);
  color: var(--ink-2);
}
.sum-value {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

/* ---------- lists ---------- */
.list-row {
  display: flex;
  align-items: center;
  min-height: var(--row-h);
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
  animation: fade-up 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
  transition: background 0.16s ease;
}
.list-row:first-child {
  border-top: none;
}
.list-row.is-pressed {
  background: var(--surface-2);
}
.list-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.list-text {
  flex: 1;
  min-width: 0;
}
.list-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}
.list-sub {
  margin-top: 4rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
}
.list-side {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-left: var(--sp-2);
}
.list-chev {
  color: var(--ink-3);
  font-size: 40rpx;
  line-height: 1;
  margin-left: var(--sp-1);
}
.list-row .bubble.sm {
  margin-right: var(--sp-2);
}

/* ---------- timeline ---------- */
.timeline-row {
  display: flex;
  align-items: center;
  min-height: var(--timeline-h);
  padding: var(--sp-3) 0;
  border-top: 1rpx solid var(--line);
  animation: fade-up 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
  transition: background 0.16s ease;
}
.timeline-row:first-child {
  border-top: none;
}
.timeline-row.is-pressed {
  background: var(--surface-2);
}
.timeline-clock {
  width: 128rpx;
  flex-shrink: 0;
  margin-right: var(--sp-2);
  padding: 0;
  color: var(--ink);
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.1;
  text-align: left;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.5rpx;
}
.elder .timeline-clock {
  width: 168rpx;
}
.timeline-row .bubble {
  margin-right: var(--sp-2);
}
.timeline-body {
  flex: 1;
  min-width: 0;
}
.timeline-title {
  font-size: var(--fs-heading);
  font-weight: 600;
  line-height: 1.35;
  color: var(--ink);
  overflow-wrap: anywhere;
}
.timeline-meta {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
}
.timeline-chev {
  color: var(--ink-3);
  font-size: 36rpx;
  line-height: 1;
  margin-left: var(--sp-1);
}

/* ---------- status / progress ---------- */
.pill {
  display: inline-flex;
  align-items: center;
  vertical-align: middle;
  min-height: 44rpx;
  padding: 0 var(--sp-2);
  border-radius: var(--r-pill);
  font-size: var(--fs-caption);
  font-weight: 600;
  line-height: 1.2;
}
.pill.pending {
  background: var(--brand-soft);
  color: var(--brand-ink);
}
.pill.gold {
  background: var(--gold-soft);
  color: var(--gold-ink);
}
.pill.done {
  background: var(--sage-soft);
  color: var(--sage-deep);
}
.pill.skip {
  background: var(--surface-2);
  color: var(--ink-2);
}
.progress {
  height: 12rpx;
  border-radius: var(--r-pill);
  background: var(--surface-3);
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: var(--r-pill);
  background: var(--sage-deep);
}
.progress-fill.brand {
  background: var(--brand-strong);
}
.elder .progress {
  height: 16rpx;
}

/* ---------- avatar / code ---------- */
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--brand-soft);
  color: var(--brand-ink);
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.avatar.lg {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 36rpx;
}
.code {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  font-variant-numeric: tabular-nums;
  color: var(--ink);
}

/* ---------- date bar / collapse ---------- */
.datebar {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-card);
  margin-bottom: var(--sp-3);
  overflow: hidden;
  animation: fade-up 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.date-btn {
  width: var(--tap-min);
  height: var(--control-h);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-ink);
  font-size: 48rpx;
  line-height: 1;
  transition: background 0.16s ease, transform 0.14s ease;
}
.date-btn.is-pressed {
  background: var(--surface-2);
}
.datebar-main {
  flex: 1;
  min-height: var(--control-h);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-heading);
  font-weight: 600;
  color: var(--ink);
}
.collapse-head {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--tap-min);
  color: var(--brand-ink);
  font-size: var(--fs-label);
  font-weight: 600;
}
.collapse-head .chev {
  transform: rotate(90deg);
  transition: transform 0.15s;
}
.collapse-head.open .chev {
  transform: rotate(-90deg);
}

/* ---------- save bar / danger / error / skeleton ---------- */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: var(--sp-2) var(--page-x) calc(var(--sp-2) + env(safe-area-inset-bottom));
  background: rgba(251, 246, 241, 0.97);
  border-top: 1rpx solid var(--line);
  box-shadow: var(--shadow-bar);
  animation: save-bar-in 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes save-bar-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.save-bar-row {
  display: flex;
  align-items: center;
}
.save-bar-row .btn {
  flex: 1;
}
.save-bar-row .btn + .btn {
  margin-left: var(--sp-2);
}
.danger-zone {
  margin-top: var(--sp-5);
  text-align: center;
}
.error-state {
  text-align: center;
}
.error-state .heading {
  margin-bottom: var(--sp-1);
}
.error-state .btn {
  margin-top: var(--sp-3);
}
.skeleton-card {
  background: var(--surface);
  border-radius: var(--r-card);
  padding: var(--sp-4);
  margin-bottom: var(--sp-3);
  box-shadow: var(--shadow-card);
}
.skeleton-line {
  height: 28rpx;
  margin-bottom: var(--sp-2);
  border-radius: var(--r-pill);
  background: linear-gradient(90deg, var(--surface-2) 25%, #FFFFFF 50%, var(--surface-2) 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.4s linear infinite;
}
.skeleton-line.w-40 { width: 40%; }
.skeleton-line.w-70 { width: 70%; }
.skeleton-line:last-child { margin-bottom: 0; }
@keyframes skeleton-shimmer {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}

/* ============================================================
   Motion
   ============================================================ */
.delay-1 { animation-delay: 0.05s; }
.delay-2 { animation-delay: 0.1s; }
.delay-3 { animation-delay: 0.16s; }
.delay-4 { animation-delay: 0.22s; }
.delay-5 { animation-delay: 0.28s; }

@keyframes page-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes fade-up {
  from { opacity: 0; transform: translateY(22rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.page.settled,
.page.settled .page-head,
.page.settled .card,
.page.settled .quick-card,
.page.settled .stat-tile,
.page.settled .list-row,
.page.settled .timeline-row,
.page.settled .datebar,
.page.settled .segmented,
.page.settled .save-bar {
  animation: none;
}

/* ---------- medication pulse ---------- */
.med-title {
  display: flex;
  align-items: center;
}
.pulse-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
  animation: dot-pulse 2.2s ease-in-out infinite;
}
@keyframes dot-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* ============================================================
   Dashboard / product components
   ============================================================ */
.today-board {
  background: var(--surface-2);
  border-color: var(--line);
}
.board-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.board-date {
  flex: 1;
  min-width: 0;
}
.board-avatar {
  width: var(--board-avatar);
  height: var(--board-avatar);
  border-radius: 20rpx;
  border: 1rpx solid var(--brand-tint-strong);
  background: var(--surface);
  color: var(--brand-ink);
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.board-name {
  margin-top: 12rpx;
  font-size: var(--fs-display);
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: -0.5rpx;
  color: var(--ink);
  overflow-wrap: anywhere;
  word-break: break-word;
}
.board-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 16rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
}
.board-day {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  margin-right: 12rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: var(--brand-strong);
  color: #FFFFFF;
  font-size: var(--fs-caption);
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
}
.board-stage {
  flex: 1;
  min-width: 0;
  line-height: 1.4;
}
.board-divider {
  height: 1rpx;
  margin: var(--sp-3) 0;
  background: var(--line);
}
.today-board .eyebrow {
  color: var(--brand-ink);
}
.board-metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.board-metric {
  min-width: 0;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}
.board-metric:nth-child(1),
.board-metric:nth-child(2) {
  border-top: none;
}
.board-metric:nth-child(even) {
  padding-left: 24rpx;
  border-left: 1rpx solid var(--line);
}
.board-metric-label {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--brand-ink);
}
.board-metric-line {
  display: flex;
  align-items: baseline;
  flex-wrap: nowrap;
  margin-top: 6rpx;
}
.board-metric-value {
  font-size: var(--fs-display);
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -1rpx;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  flex-shrink: 0;
}
.board-metric-unit {
  margin-left: 6rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink-3);
  white-space: nowrap;
  flex-shrink: 0;
}
.record-list {
  margin-top: 8rpx;
}
.record-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
}
.record-row + .record-row {
  border-top: 1rpx solid var(--line);
}
.record-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.record-body {
  flex: 1;
  min-width: 0;
}
.record-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.record-label {
  font-size: var(--fs-heading);
  font-weight: 600;
  color: var(--ink-2);
  white-space: nowrap;
}
.record-main {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  margin-left: 16rpx;
  white-space: nowrap;
}
.record-num {
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.1;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.record-unit {
  margin-left: 6rpx;
  font-size: var(--fs-label);
  color: var(--ink-3);
  white-space: nowrap;
}
.record-sub {
  margin-top: 8rpx;
  font-size: var(--fs-body);
  line-height: 1.5;
  color: var(--ink-3);
  overflow-wrap: anywhere;
}
.detail-parts {
  display: flex;
  margin-top: 10rpx;
}
.detail-parts .part {
  flex: 1;
  min-width: 0;
}
.detail-parts .part + .part {
  margin-left: 16rpx;
}
.part-label {
  display: block;
  font-size: var(--fs-label);
  color: var(--ink-3);
}
.part-main {
  display: flex;
  align-items: baseline;
  margin-top: 2rpx;
  white-space: nowrap;
}
.part-num {
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.1;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.part-unit {
  margin-left: 4rpx;
  font-size: var(--fs-label);
  color: var(--ink-3);
  white-space: nowrap;
}
.since-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}
.since-row + .since-row {
  border-top: 1rpx solid var(--line);
}
.since-row .bubble {
  margin-right: 16rpx;
}
.since-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.since-label {
  font-size: var(--fs-body);
  color: var(--ink-2);
}
.since-value {
  margin-left: 16rpx;
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.detail-block {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}
.detail-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--ink-2);
}
.detail-row + .detail-row {
  margin-top: 4rpx;
}
.detail-label {
  margin-right: 6rpx;
  color: var(--ink-2);
}
.detail-value {
  font-weight: 600;
  color: var(--ink);
}
.detail-sep {
  margin: 0 10rpx;
  color: var(--ink-3);
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}
.summary-item {
  min-width: 0;
  padding: 0 12rpx;
  border-left: 1rpx solid var(--line);
}
.summary-item:first-child {
  padding-left: 0;
  border-left: none;
}
.summary-line {
  display: flex;
  align-items: baseline;
  flex-wrap: nowrap;
  margin-top: 6rpx;
}
.summary-value {
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.5rpx;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  flex-shrink: 0;
}
.summary-unit {
  margin-left: 2rpx;
  font-size: var(--fs-eyebrow);
  font-weight: 600;
  color: var(--ink-3);
  white-space: nowrap;
  flex-shrink: 0;
}
.summary-foot {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--sp-3);
  padding-top: var(--sp-2);
  border-top: 1rpx solid var(--line);
}
.since-inline {
  display: flex;
  align-items: center;
  margin: 0 var(--sp-3) 6rpx 0;
  font-size: var(--fs-eyebrow);
  color: var(--ink-2);
}
.since-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.since-dot.feed { background: #3E6E85; }
.since-dot.diaper { background: #94652F; }
.since-dot.sleep { background: #6E5A7E; }

.link.sm {
  min-height: 56rpx;
  font-size: var(--fs-eyebrow);
  font-weight: 600;
}

.segmented.sm .segmented-item {
  min-height: 56rpx;
  font-size: var(--fs-eyebrow);
}

/* chart */
.chart {
  margin-top: var(--sp-3);
}
.chart-row {
  display: flex;
  align-items: flex-end;
  height: 200rpx;
}
.chart-col {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.chart-value {
  margin-bottom: 6rpx;
  font-size: var(--fs-eyebrow);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}
.elder .summary-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  row-gap: var(--sp-2);
}
.elder .summary-item {
  padding: 0;
  border-left: none;
}
.elder .summary-item:nth-child(even) {
  padding-left: var(--sp-2);
  border-left: 1rpx solid var(--line);
}
.elder .chart-row {
  height: 220rpx;
}
.elder .chart-track {
  height: 150rpx;
}
.elder .chart-value {
  font-size: var(--fs-eyebrow);
}
.elder .chart-label {
  font-size: var(--fs-eyebrow);
}
.chart-track {
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  border-bottom: 1rpx solid var(--line);
}
.chart-bar {
  width: 64%;
  max-width: 40rpx;
  min-width: 12rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: var(--brand);
  transition: height 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}
.chart-bar.zero {
  background: var(--surface-3);
}
.chart-bar.today {
  background: var(--brand-ink);
}
.chart-label {
  margin-top: 8rpx;
  font-size: var(--fs-eyebrow);
  color: var(--ink-3);
}
.chart-label.today {
  color: var(--brand-ink);
  font-weight: 600;
}
.chart-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-2);
  padding-top: var(--sp-2);
  border-top: 1rpx solid var(--line);
}
.chart-avg {
  font-size: var(--fs-eyebrow);
  color: var(--ink-2);
}
.chart-empty {
  padding: var(--sp-4) 0;
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}
.chart-range {
  margin-top: var(--sp-1);
  text-align: center;
  font-size: var(--fs-eyebrow);
  color: var(--ink-3);
}
.chart-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: var(--sp-3);
  padding-top: var(--sp-2);
  border-top: 1rpx solid var(--line);
}
.chart-summary-item {
  min-width: 0;
}
.chart-summary-value {
  margin-top: 4rpx;
  font-size: var(--fs-label);
  font-weight: 700;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}

/* tool grid */
.tool-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: var(--sp-2);
}
.tool-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 124rpx;
  border-radius: var(--r-control);
  background: var(--surface-2);
  transition: background 0.16s ease, transform 0.14s ease;
}
.tool-tile.is-pressed {
  background: var(--surface-3);
  transform: scale(0.97);
}
.tool-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.tool-label {
  font-size: var(--fs-eyebrow);
  font-weight: 600;
  color: var(--ink);
}
.elder .tool-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.elder .tool-tile {
  min-height: 140rpx;
}

/* home quick actions: 2x2 large targets */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}
.quick-action {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--r-control);
  background: var(--surface-2);
  transition: background 0.16s ease, transform 0.14s ease;
}
.quick-action.is-pressed {
  background: var(--surface-3);
  transform: scale(0.97);
}
.quick-action-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.quick-action-label {
  font-size: var(--fs-heading);
  font-weight: 600;
  color: var(--ink);
}
.elder .quick-actions {
  grid-template-columns: 1fr;
  gap: 20rpx;
}
.elder .quick-action {
  min-height: 140rpx;
}
.elder .quick-action-icon {
  width: 72rpx;
  height: 72rpx;
}

/* key-value summary */
.kv-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: var(--sp-3);
}
.kv-item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  min-width: 0;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--line);
}
.kv-grid .kv-item:nth-child(-n + 2) {
  border-top: none;
}
.kv-label {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}
.kv-value {
  margin-left: var(--sp-2);
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.pill.accent {
  background: var(--accent-strong);
  color: #FFFFFF;
}
.card-accent .btn-primary {
  background: var(--accent-strong);
}
.card-accent .btn-primary.is-pressed,
.card-accent .btn-primary:active {
  background: var(--accent-ink);
}
.progress-fill.accent {
  background: var(--accent-strong);
}
.card-accent .med-action {
  border-top-color: var(--accent-tint);
}
.since-repeat {
  margin-top: 8rpx;
  color: var(--brand-ink);
  font-size: var(--fs-caption);
  font-weight: 600;
}
.day-stack {
  display: flex;
  flex-direction: column;
}
.day-stack.history .day-summary { order: 1; }
.day-stack.history .day-flow { order: 2; }
.day-stack.history .day-actions { order: 3; }

/* ---------- stool dots ---------- */
.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.dot-yellow { background: #E2B13C; }
.dot-green { background: #7D9A4E; }
.dot-brown { background: #8A5A32; }
.dot-meconium { background: #2C3428; }
.dot-clay { background: #E7E0D6; border: 1rpx solid #C8BFB4; }
.dot-blood { background: #C4624E; }

/* ---------- medication detail ---------- */
.med-time {
  font-size: var(--fs-title);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.dose-block {
  padding: var(--sp-2) 0;
  border-top: 1rpx solid var(--line);
}
.dose-block:first-child {
  padding-top: 0;
  border-top: none;
}
.dose-actions {
  display: flex;
  align-items: center;
}
.dose-actions .btn + .btn {
  margin-left: var(--sp-2);
}
.dose-edit {
  padding-top: var(--sp-2);
}
