.bar {
  --tabbar-h: 120rpx;
  --fs-caption: 24rpx;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  background: var(--surface, #FFFFFF);
  border-top: 1rpx solid var(--line, #E6E0F0);
  padding-bottom: env(safe-area-inset-bottom);
}
.item {
  flex: 1;
  height: var(--tabbar-h);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--ink-3, #6F6781);
  font-size: var(--fs-caption);
  font-weight: 600;
  transition: color 0.2s ease, background 0.16s ease;
}
.item-pressed {
  background: var(--surface-2, #F1EDFA);
}
.item.on {
  color: var(--brand-ink, #4B3BB5);
}
.tab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
.item.on .tab-icon {
  animation: tab-pop 0.38s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes tab-pop {
  0% { transform: scale(1); }
  45% { transform: scale(1.2); }
  100% { transform: scale(1); }
}
.item-text {
  margin-top: 4rpx;
}
.bar.elder {
  --tabbar-h: 140rpx;
  --fs-caption: 30rpx;
}
