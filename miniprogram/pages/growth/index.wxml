<view class="page {{elder ? 'elder' : ''}}">
  <block wx:if="{{loading}}">
    <view class="skeleton-card">
      <view class="skeleton-line w-40"></view>
      <view class="skeleton-line"></view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-line w-70"></view>
      <view class="skeleton-line"></view>
    </view>
  </block>

  <view wx:elif="{{pageError}}" class="card error-state">
    <view class="heading">还没连上云</view>
    <view class="caption mt-1">{{pageError}}</view>
    <button class="btn btn-primary btn-block" hover-class="is-pressed" bindtap="retry">再试一次</button>
  </view>

  <block wx:else>
    <view class="page-head">
      <view class="page-head-main">
        <view class="display">身高体重</view>
        <view class="caption mt-1">儿保或在家量到的数字。这里不画正常范围。</view>
      </view>
      <view class="avatar lg tone-growth"><icon name="growth" size="{{56}}" elder="{{elder}}" /></view>
    </view>

    <view wx:if="{{formError}}" class="form-alert">{{formError}}</view>

    <view class="card">
      <view class="field">
        <text class="label">量的是哪一天</text>
        <picker mode="date" value="{{day}}" bindchange="onDay">
          <view class="input picker-face">{{day}}<text class="chev">›</text></view>
        </picker>
      </view>
      <view class="field">
        <text class="label">体重</text>
        <stepper elder="{{elder}}" value="{{weightG}}" min="{{0}}" max="{{50000}}" step="{{10}}" unit="克" bind:change="onWeight" />
        <view class="muted mt-1" wx:if="{{weightHint}}">{{weightHint}}</view>
      </view>
      <view class="field">
        <text class="label">身长</text>
        <stepper elder="{{elder}}" value="{{heightCm}}" min="{{0}}" max="{{160}}" step="{{0.5}}" unit="厘米" bind:change="onHeight" />
      </view>
      <view class="field">
        <text class="label">头围</text>
        <stepper elder="{{elder}}" value="{{headCm}}" min="{{0}}" max="{{80}}" step="{{0.5}}" unit="厘米" bind:change="onHead" />
      </view>
      <button
        class="btn btn-primary btn-block mt-3"
        hover-class="is-pressed"
        loading="{{saving}}"
        disabled="{{saving}}"
        bindtap="save"
      >记下这次</button>
    </view>

    <view class="card">
      <view class="section-head">
        <view class="section-title">历史</view>
        <view class="sub" wx:if="{{list.length}}">{{list.length}} 次</view>
      </view>
      <empty
        wx:if="{{!list.length}}"
        compact
        icon="growth"
        tone="growth"
        title="还没有记录"
        hint="儿保量完身高体重，回来记一笔。"
        elder="{{elder}}"
      />
      <view class="list-row" wx:for="{{list}}" wx:key="_id" style="animation-delay: {{index * 40 + 160}}ms">
        <view class="list-text">
          <view class="list-title">{{item.pretty}}</view>
          <view class="list-sub">{{item.text}}</view>
        </view>
        <button class="btn-text danger" data-id="{{item._id}}" catchtap="remove">删除</button>
      </view>
    </view>
  </block>
</view>
