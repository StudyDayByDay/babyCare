.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid #E7E1D8;
  padding-bottom: env(safe-area-inset-bottom);
}

.item {
  flex: 1;
  height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6E7872;
  font-size: 24rpx;
  font-weight: 600;
}

.ico-wrap {
  opacity: 0.38;
  margin-bottom: 4rpx;
}

.item.on {
  color: #3E6B58;
}

.item.on .ico-wrap {
  opacity: 1;
}

.mark {
  width: 28rpx;
  height: 6rpx;
  border-radius: 999rpx;
  margin-top: 6rpx;
  background: transparent;
}

.item.on .mark {
  background: #3E6B58;
}

.elder .item {
  height: 140rpx;
  font-size: 30rpx;
}
