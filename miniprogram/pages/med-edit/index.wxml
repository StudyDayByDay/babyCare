<view class="page form {{elder ? 'elder' : ''}}">
  <block wx:if="{{loading}}">
    <view class="skeleton-card">
      <view class="skeleton-line w-40"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line w-70"></view>
    </view>
  </block>

  <view wx:elif="{{pageError}}" class="card error-state">
    <view class="heading">还没连上云</view>
    <view class="caption mt-1">{{pageError}}</view>
    <button class="btn btn-primary btn-block" hover-class="is-pressed" bindtap="retry">再试一次</button>
  </view>

  <block wx:else>
    <view class="page-head">
      <view class="page-head-main">
        <view class="display">{{id ? '修改用药' : '添加用药'}}</view>
        <view class="caption mt-1">第 {{step}} / 3 步 · {{stepTitle}}</view>
      </view>
    </view>
    <view class="progress mb-3">
      <view class="progress-fill brand" style="width: {{stepPercent}}%;"></view>
    </view>

    <view wx:if="{{formError}}" class="form-alert">{{formError}}</view>

    <view class="card" wx:if="{{step === 1}}">
      <view class="caption mb-3">{{stepHint}}</view>
      <view class="field">
        <text class="label required">药名</text>
        <input
          class="input {{errors.name ? 'is-error' : ''}}"
          value="{{name}}"
          maxlength="40"
          bindinput="onName"
          placeholder="按药盒上的名字写"
          placeholder-class="input-ph"
        />
        <text class="field-error" wx:if="{{errors.name}}">{{errors.name}}</text>
      </view>
      <view class="field">
        <text class="label">一次吃多少</text>
        <stepper elder="{{elder}}" value="{{doseAmount}}" min="{{0.5}}" max="{{100}}" step="{{0.5}}" bind:change="onAmount" />
      </view>
      <view class="field">
        <text class="label">单位</text>
        <picker mode="selector" range="{{units}}" value="{{unitIndex}}" bindchange="onUnit">
          <view class="input picker-face">{{units[unitIndex]}}<text class="chev">›</text></view>
        </picker>
      </view>
    </view>

    <view class="card" wx:if="{{step === 2}}">
      <view class="caption mb-3">{{stepHint}}</view>
      <view class="field">
        <text class="label">频率</text>
        <view class="chips">
          <view class="chip {{frequencyType === 'timesPerDay' ? 'on' : ''}}" data-value="timesPerDay" bindtap="onFreq" hover-class="is-pressed">一天几次</view>
          <view class="chip {{frequencyType === 'intervalHours' ? 'on' : ''}}" data-value="intervalHours" bindtap="onFreq" hover-class="is-pressed">每隔几小时</view>
          <view class="chip {{frequencyType === 'asNeeded' ? 'on' : ''}}" data-value="asNeeded" bindtap="onFreq" hover-class="is-pressed">按需</view>
        </view>
      </view>

      <block wx:if="{{frequencyType === 'timesPerDay'}}">
        <view class="field">
          <text class="label">一天几次</text>
          <stepper elder="{{elder}}" value="{{timesPerDay}}" min="{{1}}" max="{{6}}" step="{{1}}" unit="次" bind:change="onTimes" />
        </view>
        <view class="field">
          <view class="switch-row">
            <view class="switch-copy">
              <view class="body">每一顿数量相同</view>
              <view class="caption">不一样的话，下面可以单独改</view>
            </view>
            <switch checked="{{sameDose}}" color="{{theme.brandStrong}}" bindchange="onSame" />
          </view>
        </view>
        <view class="field" wx:for="{{slots}}" wx:key="index">
          <text class="label">第 {{index + 1}} 顿</text>
          <view class="pair">
            <view class="pair-item">
              <picker mode="time" value="{{item.time}}" data-index="{{index}}" bindchange="onSlotTime">
                <view class="input picker-face">{{item.time}}<text class="chev">›</text></view>
              </picker>
            </view>
            <view class="pair-item" wx:if="{{!sameDose}}">
              <stepper elder="{{elder}}" value="{{item.doseAmount}}" min="{{0.5}}" max="{{100}}" step="{{0.5}}" unit="{{units[unitIndex]}}" data-index="{{index}}" bind:change="onSlotAmount" />
            </view>
          </view>
        </view>
      </block>

      <block wx:if="{{frequencyType === 'intervalHours'}}">
        <view class="field">
          <text class="label">每隔几小时</text>
          <stepper elder="{{elder}}" value="{{intervalHours}}" min="{{1}}" max="{{24}}" step="{{1}}" unit="小时" bind:change="onInterval" />
        </view>
        <view class="field">
          <text class="label">第一顿时间</text>
          <picker mode="time" value="{{firstTime}}" bindchange="onFirstTime">
            <view class="input picker-face">{{firstTime}}<text class="chev">›</text></view>
          </picker>
        </view>
      </block>

      <view class="caption" wx:if="{{frequencyType === 'asNeeded'}}">按需用药不排时间，需要时在用药列表点「现在吃了」。</view>
    </view>

    <view class="card" wx:if="{{step === 3}}">
      <view class="caption mb-3">{{stepHint}}</view>
      <view class="field">
        <text class="label">从哪天开始</text>
        <picker mode="date" value="{{startDay}}" bindchange="onStart">
          <view class="input picker-face">{{startDay}}<text class="chev">›</text></view>
        </picker>
      </view>
      <view class="field" wx:if="{{frequencyType !== 'asNeeded'}}">
        <text class="label">吃几天</text>
        <stepper elder="{{elder}}" value="{{days}}" min="{{1}}" max="{{366}}" step="{{1}}" unit="天" bind:change="onDays" />
        <view class="chips mt-2">
          <view
            class="chip {{days == item.days ? 'on' : ''}}"
            wx:for="{{spans}}"
            wx:key="days"
            data-days="{{item.days}}"
            bindtap="setDays"
            hover-class="is-pressed"
          >{{item.label}}</view>
        </view>
        <view class="muted mt-1">吃到 {{endDay}}。也可以直接输入天数。</view>
      </view>
      <view class="field">
        <text class="label">备注</text>
        <view class="chips">
          <view
            class="chip {{mealNote === item ? 'on' : ''}}"
            wx:for="{{meals}}"
            wx:key="*this"
            data-value="{{item}}"
            bindtap="onMeal"
            hover-class="is-pressed"
          >{{item || '无'}}</view>
        </view>
      </view>
      <view class="switch-row">
        <view class="switch-copy">
          <view class="heading">到点提醒</view>
          <view class="caption">同一分钟的药合成一条微信通知</view>
        </view>
        <switch checked="{{remind}}" color="{{theme.brandStrong}}" bindchange="onRemind" />
      </view>
    </view>

    <view class="card card-accent" wx:if="{{step === 3}}">
      <view class="caption">确认一下</view>
      <view class="body mt-1">{{summaryText}}</view>
    </view>
  </block>

  <view class="save-bar" wx:if="{{!loading && !pageError}}">
    <view class="save-bar-row">
      <button wx:if="{{step > 1}}" class="btn btn-secondary" hover-class="is-pressed" bindtap="prev">上一步</button>
      <button wx:if="{{step !== 3}}" class="btn btn-primary" hover-class="is-pressed" bindtap="next">下一步</button>
      <button
        wx:else
        class="btn btn-primary"
        hover-class="is-pressed"
        loading="{{saving}}"
        disabled="{{saving}}"
        bindtap="save"
      >保存疗程</button>
    </view>
  </view>
</view>
